# Copy to .env.local and fill in. Without the Supabase values the site still
# runs and renders the sample catalogue from lib/data/seed.json; the admin app
# needs them.

# Supabase — same project as the LINE CRM, different tables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical URL, used for metadata, JSON-LD and the sitemap
NEXT_PUBLIC_SITE_URL=https://ruedeejewelry.com

# LINE official account basic id, e.g. @ruedeejewelry.
# Every chat link on the site is built from this and carries a product code.
NEXT_PUBLIC_LINE_OA_ID=@ruedeejewelry
